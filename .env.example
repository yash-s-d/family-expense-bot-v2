# ============================================================
# Family Expense Bot - Environment Configuration
# Copy this file to `.env` and fill in your actual values.
# NEVER commit your `.env` or service account JSON to GitHub!
# ============================================================

# 1. Google Gemini AI API Key (Free tier from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# 2. Google Cloud Service Account JSON Key File
# Full local path to the downloaded service account key file
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=C:\path\to\your-service-account-key.json

# 3. Google Sheet ID
# Extracted from URL: https://docs.google.com/spreadsheets/d/1exQhj85Sv-Hhp8_Fna9qgydgYFYwZaoLRE2RnsRQ3eY/edit
GOOGLE_SHEET_ID=1exQhj85Sv-Hhp8_Fna9qgydgYFYwZaoLRE2RnsRQ3eY

# 4. Meta WhatsApp Cloud API Credentials (from developers.facebook.com)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# Any secret passphrase you choose (must match what you enter in Meta webhook config)
WHATSAPP_VERIFY_TOKEN=family_expense_secret_token

# 5. Family Members WhatsApp Phone Numbers
# Format: Country code followed by mobile number with NO '+' and NO spaces (e.g., 919876543210)
PHONE_TANMAY=91XXXXXXXXXX
PHONE_AKSHAT=91XXXXXXXXXX
PHONE_AAI=91XXXXXXXXXX
PHONE_DAD=91XXXXXXXXXX

# 6. Mode toggle
# Set to true for mock testing without real credentials, or false for live mode
USE_MOCK=false
PORT=5000
